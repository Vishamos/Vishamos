{
  "enabledPlugins": {
    "visha-common@vishas-agent": true
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build Assembly-CSharp.csproj:*)",
      "Bash(dotnet build Assembly-CSharp-Editor.csproj:*)",
      "PowerShell(dotnet build Assembly-CSharp.csproj:*)",
      "PowerShell(dotnet build Assembly-CSharp-Editor.csproj:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh label create:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api repos/Vishamos/*/contents/*)",
      "Bash(gh api repos/Vishamos/*/commits/*)",
      "Bash(gh api repos/Vishamos/*/commits?*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh label create:*)",
      "PowerShell(gh search issues:*)",
      "PowerShell(gh api repos/Vishamos/*/contents/*)",
      "PowerShell(gh api repos/Vishamos/*/commits/*)",
      "PowerShell(gh api repos/Vishamos/*/commits?*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/AppData/Local/VishaSTD/**)"
    ]
  }
}
